# Optional overrides for local development (never commit a real .env)
# PORT=7860                     # web mode port
# ORCA_DATA=./data              # data dir (config, chats, workspace)
# ORCA_GATEWAY=http://127.0.0.1:8787   # point the app at a local gateway shim instead of orca.config.json → gateway
# ORCA_BUILD_TOKEN=             # must equal the gateway's BUILD_TOKEN secret (CI sets this from GitHub Secrets)
# ORCA_DEV=1                    # enables POST /api/update/simulate for testing the update banner
