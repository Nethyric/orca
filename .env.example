# Optional overrides for local development. Never commit a real .env.
# PORT=7860                         # web-mode port (npm run web)
# ORCA_DATA=./data                  # data directory (config.json, chats, workspace)
# ORCA_VAULT_KEY=                   # vault private key (PKCS8 base64) — lets a dev build use the built-in models
# ORCA_VAULT_URL=                   # override the sealed-vault URL (e.g. a local file server while testing)
# ORCA_DEV=1                        # enables POST /api/update/simulate for testing the update banner
